[Unit]
Description=KNX Daemon
After=network.target

[Service]
ExecStart=/usr/bin/knxd /etc/knxd/knxd.conf
Type=notify

Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
# No Also=knxd.socket: this knxd build has no systemd socket-activation module,
# and knxd.socket/knxd-net.socket are intentionally masked (see ha-image.bb) to
# avoid clients hanging on /run/knx. Also= would also block `systemctl enable`
# on this masked unit.
